    ./programs/programs.nix           #сам хз зачем нужно
    ./Plasma.nix
    ./services/zram.nix               #Zram патриотическая озу
    ./services/openssh.nix            #SSH вот такое да


    #./pkgs/packages-servermaybe.nix   #пакеты серверу
