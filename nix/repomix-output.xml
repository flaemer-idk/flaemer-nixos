        8096  # Jellyfin
        47984 47989 48010 # Sunshine / Moonlight 
        64989 # хз
      ];

      allowedUDPPorts = [
        2005  # хз
        5353  # хз
        64989 # хз
      ];

      allowedUDPPortRanges = [
        { from = 47998; to = 48010; }
      ];
    };
