;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸
(defwidget tray []
  (box :class "tray"
    (systray :orientation "v" :icon-size 28 :spacing 0)))

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸    
(defwidget icon-module [icon ?class ?visible]
  (box :class "${class} icon-module"
       :orientation "h"
       :halign "end"
       :space-evenly false
       :visible {visible ?: true} ; because the argument is optional
    (label :class "icon-module__icon" :text "${icon}")
    (children)))

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸
(defwidget player []
  (icon-module :class "player" :icon "" :visible {player_listen.show == "yes"}
    (literal :content {player_listen.content})))
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸
(defwidget date []
  (box :orientation "v" 
       :class "date" 
       :space-evenly false
       :halign "center"
    (label :class "time" :text hour)
    (label :class "time"  :text min)
    (box :class "time" :halign "center" 
         (label :text "—")) ;; Тонкий разделитель
    (label :class "time" :text day :angle 90)))
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸
(defwidget nothing []
  (box :class "separator" :orientation "horizontal" :spacing 155 :space-evenly true
    (label :text "......":class "separator-label")))
  
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸
(defwidget speaker []
  (eventbox :onscroll "./modules/speaker.sh {}" 
            :class "speaker"
    (button :onclick "pwvucontrol &"          
      (box :orientation "h" 
           :space-evenly false 
           :spacing 11
        (label :class "speaker-icon" 
               :text {speaker_poll.icon})    
        (label :class "speaker-text" 
               :text {speaker_poll.content}) 
      )
    )
  )
)

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸
(defwidget battery []
  (box :class "battery"
    (icon-module :class "battery-icon" :icon {battery_poll.icon} 
      (label  :text {battery_poll.percentage}))))
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸
(defwidget bluetooth []
  (button :onclick "blueman-manager &" 
          :class "bluetooth"
    (box 
         :class "blue"
         :orientation "v"
         :space-evenly false
         :spacing 5
      (label :text {bluetooth_status})
    )
  )
)  
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸
 (defwidget network []
  (button :onclick "kitty nmtui &" ;; Открывает настройки сети
          :class "network"
    (box :space-evenly false :spacing 8
    :orientation "v"
      (label :class "net-icon" :text {net_poll.icon})
    )
  )
)     
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸
</file>

